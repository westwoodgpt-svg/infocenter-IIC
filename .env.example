# Нужны только в продакшене на Vercel (см. README → «Обязательная настройка на Vercel»).
# Локальная разработка (npm run dev) всегда работает вне Битрикс24 — в localStorage,
# эти переменные не используются.

# "Ключ приложения" / "Секретный ключ" со страницы локального приложения в Битрикс24
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Заполняются автоматически при подключении Redis-интеграции (Storage → Create Database)
# в проекте на Vercel — вручную вводить не нужно.
KV_REST_API_URL=
KV_REST_API_TOKEN=
